# .env da VPS — PRODUÇÃO. Não preencha à mão: rode
#
#   ./scripts/vps/gerar-env.sh <IP-da-VPS>
#
# que copia este modelo para .env, sorteia todos os segredos e gera o hash
# da senha de acesso. Os valores "<gerado>" abaixo são preenchidos por ele.
# O .env preenchido NUNCA vai para o git (.gitignore).

# ---- Identidade da pilha ----
# Containers, volumes e rede ficam aprimore-* e aprimore_* — não colidem com nada
# de outros sistemas na mesma máquina.
COMPOSE_PROJECT_NAME=aprimore

# ---- Banco ----
POSTGRES_PASSWORD=<gerado>

# ---- Domínio ----
# Ainda não registrado: o site responde pelo IP (MODO IP abaixo). Os
# portais de professor e de empresa (<máscara>.aprimoree.com.br) só
# passam a responder quando o domínio existir e o DNS apontar para cá.
DOMINIO_BASE=aprimoree.com.br

# ---- HTTPS / Caddy ----
# MODO IP (agora): certificado interno para o IP + senha na porta.
CADDYFILE=./caddy/Caddyfile.ip
IP_PUBLICO=<gerado>
ACESSO_USUARIO=aprimore
# Hash bcrypt da senha de acesso (o gerar-env.sh imprime a senha uma vez).
# Aspas simples: o hash tem `$`, que o Compose leria como variável.
ACESSO_SENHA_HASH='<gerado>'
#
# MODO DOMÍNIO (depois de registrar aprimoree.com.br e apontar o DNS —
# registro A de `aprimoree.com.br` e de `*.aprimoree.com.br` para o IP):
#   CADDYFILE=./caddy/Caddyfile
# e `./scripts/vps/subir.sh`. IP_PUBLICO e ACESSO_* deixam de ser usados.

# E-mail do titular dos certificados (avisos do Let's Encrypt).
ACME_EMAIL=contato@aprimoree.com.br

# Portas que o Caddy ouve no host. Se outro sistema da VPS já usa 80/443,
# o scripts/vps/verificar.sh avisa — use por exemplo 8080/8443 no modo IP.
# No modo domínio o Let's Encrypt exige 80 e 443 (ou um proxy na frente).
PORTA_HTTP=80
PORTA_HTTPS=443

# ---- Pagamento ----
# `simulado` não cobra nada, e só um webhook assinado com o WEBHOOK_SEGREDO
# sorteado confirma pagamento — ninguém de fora consegue forjar compra.
# Com a chave do sandbox do Asaas em mãos: PROVEDOR_PAGAMENTO=asaas,
# ASAAS_API_KEY=$aact_hmlg_… e o ASAAS_WEBHOOK_TOKEN abaixo cadastrado como
# authToken do webhook no painel do Asaas (URL: https://<IP>/api/webhook).
# Produção do Asaas só depois de testar a compra inteira: ASAAS_AMBIENTE=producao
# e a chave $aact_prod_.
PROVEDOR_PAGAMENTO=simulado
ASAAS_AMBIENTE=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=<gerado>
WEBHOOK_SEGREDO=<gerado>

# ---- Vídeo ----
# Obrigatório em produção: assina os endereços das aulas.
VIDEO_SEGREDO=<gerado>
DOCUMENTO_MAX_BYTES=52428800

# ---- Primeira subida ----
# Importa o vade-mécum do Planalto (~3 min, uma vez só).
IMPORTAR_LEIS=1

# ---- Desenvolvimento: desligado ----
ALUNO_DEMO=

# ---- Limites (para não disputar a máquina com outros sistemas) ----
LIMITE_MEMORIA_WEB=1536m
LIMITE_MEMORIA_BANCO=1g
